# Backend API URL
# For production, set this to your deployed backend URL (e.g., https://inflamm-ai-backend.onrender.com)
# For local development, defaults to http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# API Keys
# Get your API key from https://newsapi.org (Free tier available)
# Note: No NEXT_PUBLIC_ prefix - this is server-side only for security
NEWS_API_KEY=your_api_key_here
